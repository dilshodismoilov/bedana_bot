# Bot token from @BotFather
BOT_TOKEN=
# Private group that receives orders. Every member of this group is an admin of the shop.
# Send /here in the group to get this value.
GROUP_ID=
# Link that opens the Mini App: https://t.me/<bot_username> (BotFather -> Bot Settings -> Configure Mini App)
APP_LINK=https://t.me/your_bot
API_PORT=3000
DATA_DIR=data
# 1 = local development: requests without Telegram initData act as an admin user (id 1)
DEV=0
