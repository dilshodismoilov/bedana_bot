# Bot token from @BotFather
BOT_TOKEN=
# Private group that receives orders. Every member of this group is an admin of the shop.
# Send /here in the group to get this value.
GROUP_ID=
# Link that opens the Mini App: https://t.me/<bot_username> (BotFather -> Bot Settings -> Configure Mini App)
APP_LINK=https://t.me/your_bot
API_PORT=3000
DATA_DIR=data
# Optional log group: send /here in it and put the number here. The bot posts logs there.
LOG_GROUP_ID=
# Which logs go to the log group: debug (every request), info (app opens, orders, locations, admin changes),
# warn (slow requests, refused input, failed customer messages, client errors), error (crashes), off. Default: info
LOG_LEVEL=info
# Requests slower than this many milliseconds are logged as warnings. Default: 1500
SLOW_MS=1500
# 1 = local development: requests without Telegram initData act as an admin user (id 1)
DEV=0
