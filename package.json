{
  "name": "bedana-shop",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/main.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test server/*.test.ts",
    "seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@preact/signals": "^2.11.4",
    "hono": "^4.13.19",
    "preact": "^11.2.0",
    "wouter-preact": "^3.13.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@types/telegram-web-app": "^10.1.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
